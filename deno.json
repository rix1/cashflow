{
  "tasks": {
    "import": "deno run --allow-read --allow-write=. --allow-ffi --allow-env src/main.ts import",
    "rebuild": "deno run --allow-read --allow-write=. --allow-ffi --allow-env src/main.ts rebuild",
    "categorize": "deno run --allow-read --allow-write=. --allow-ffi --allow-env src/main.ts categorize",
    "serve": "deno run --allow-read --allow-write=. --allow-ffi --allow-env --allow-net=127.0.0.1,icons.duckduckgo.com src/main.ts serve",
    "dev": "deno run --watch --allow-read --allow-write=. --allow-ffi --allow-env --allow-net=127.0.0.1,icons.duckduckgo.com src/main.ts serve",
    "test": "deno test --allow-read --allow-write=. --allow-ffi --allow-env",
    "check": "deno check src/main.ts && deno lint && deno fmt --check",
    "lexer": "deno run --watch --allow-read src/lexer/lexer.debug.ts"
  },
  "imports": {
    "@std/csv": "jsr:@std/csv@^1.0.4",
    "@std/fs": "jsr:@std/fs@^1.0.10",
    "@std/path": "jsr:@std/path@^1.0.8",
    "@std/assert": "jsr:@std/assert@^1.0.8",
    "@std/cli": "jsr:@std/cli@^1.0.6",
    "@db/sqlite": "jsr:@db/sqlite@^0.12.0",
    "hono": "jsr:@hono/hono@^4.6.0"
  },
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "hono/jsx",
    "strict": true
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-explicit-any",
        "jsx-key"
      ]
    },
    "exclude": [
      "src/web/static/"
    ]
  },
  "fmt": {
    "exclude": [
      "docs/",
      "README.md",
      "LICENCE.md",
      "src/web/static/"
    ]
  }
}
